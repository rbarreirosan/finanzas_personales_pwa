# ============================================================================
# Credenciales de Supabase (Settings -> API en tu proyecto)
# ----------------------------------------------------------------------------
# Copia este archivo a `.env` y rellena tus valores reales.
# El archivo `.env` esta en .gitignore: NUNCA se sube al repositorio.
#
#   cp .env.example .env
#
# Estas variables las lee Vite en tiempo de build/dev via import.meta.env.
# El prefijo VITE_ es obligatorio para que Vite las exponga al frontend.
# ============================================================================

# Project URL  (ej: https://xxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# anon public key  (la clave "anon"/"public", NO la service_role)
VITE_SUPABASE_ANON_KEY=
